# ──────────────────────────────────────────
# TicketBox — Environment Variables Template
# Copy to .env and fill in real values.
# NEVER commit .env with real secrets.
# ──────────────────────────────────────────

# ── App ──────────────────────────────────
NODE_ENV=development
API_PORT=3001
FRONTEND_AUDIENCE_URL=http://localhost:3000
FRONTEND_ADMIN_URL=http://localhost:3002

# ── PostgreSQL ────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=ticketbox
DATABASE_PASSWORD=
DATABASE_NAME=ticketbox
# Full URL (used by TypeORM data-source CLI)
DATABASE_URL=postgresql://ticketbox:CHANGE_ME@localhost:5432/ticketbox

# ── Redis ─────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Full URL (used by bullMQ / ioredis)
REDIS_URL=redis://localhost:6379

# ── MinIO / Object Storage ────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=ticketbox

# ── JWT ───────────────────────────────────
# Generate strong secrets: openssl rand -hex 64
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# QR token signing secret (HMAC-SHA256)
QR_TOKEN_SECRET=

# ── Payment — VNPAY Sandbox ───────────────
# Register at: https://sandbox.vnpayment.vn/
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_SANDBOX_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/payment/result
VNPAY_IPN_URL=http://localhost:3001/api/v1/payments/callback/vnpay

# ── AI Service — OpenAI ───────────────────
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Max characters of PDF text sent to AI
AI_TEXT_MAX_CHARS=8000

# ── Email — SendGrid ──────────────────────
# Get key at: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@ticketbox.example.com
SENDGRID_FROM_NAME=TicketBox

# ── Rate Limiting ─────────────────────────
RATE_LIMIT_PUBLIC_READ_TTL=60000
RATE_LIMIT_PUBLIC_READ_LIMIT=100
RATE_LIMIT_ORDER_TTL=60000
RATE_LIMIT_ORDER_LIMIT=5
RATE_LIMIT_CHECKIN_TTL=60000
RATE_LIMIT_CHECKIN_LIMIT=60
RATE_LIMIT_ADMIN_TTL=60000
RATE_LIMIT_ADMIN_LIMIT=3

# ── Order Hold ────────────────────────────
ORDER_HOLD_MINUTES=10

# ── Cache TTL (seconds) ───────────────────
CACHE_CONCERT_LIST_TTL=60
CACHE_CONCERT_DETAIL_TTL=120
CACHE_AVAILABILITY_TTL=10
CACHE_PERMISSION_TTL=300

# MAIL 
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password
MAIL_FROM=your-email@gmail.com
