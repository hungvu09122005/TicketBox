{
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    
    // THÊM ĐOẠN NÀY ĐỂ KẾT NỐI CÁC APP
    "baseUrl": ".",
    "paths": {
      "@api/*": ["apps/api/src/*"],
      "@mobile/*": ["mobile-checkin/src/*"]
    }
  }
}