{
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@api/*": ["apps/api/src/*"],
      "@mobile/*": ["mobile-checkin/src/*"],
      "@nestjs/*": ["node_modules/@nestjs/*"]
    }
  }
}