{
  "name": "@ticketbox/api",
  "version": "0.1.0",
  "private": true,
  "description": "TicketBox Backend API — NestJS Modular Monolith",
  "scripts": {
    "dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config jest.e2e.config.ts --runInBand",
    "seed": "ts-node --transpile-only -r tsconfig-paths/register --project tsconfig.json src/database/seed.ts",
    "seed:run": "ts-node --transpile-only -r tsconfig-paths/register --project tsconfig.json src/database/seed.ts",
    "migration:generate": "npx typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts",
    "migration:run": "npx typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "migration:revert": "npx typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "migration:show": "npx typeorm-ts-node-commonjs migration:show -d src/database/data-source.ts",
    "typeorm": "npx typeorm-ts-node-commonjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1069.0",
    "@aws-sdk/s3-request-presigner": "^3.1069.0",
    "@bull-board/api": "^8.0.0",
    "@bull-board/express": "^8.0.0",
    "@bull-board/nestjs": "^8.0.0",
    "@nestjs-modules/mailer": "^2.3.7",
    "@nestjs/bull": "^11.0.4",
    "@nestjs/bullmq": "^10.1.1",
    "@nestjs/cache-manager": "^3.1.2",
    "@nestjs/common": "^10.3.10",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.3.10",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/microservices": "^10.4.22",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.10",
    "@nestjs/schedule": "^4.0.2",
    "@nestjs/swagger": "^7.3.1",
    "@nestjs/terminus": "^10.3.0",
    "@nestjs/throttler": "^5.1.2",
    "@nestjs/typeorm": "^10.0.2",
    "@sendgrid/mail": "^8.1.3",
    "bcrypt": "^5.1.1",
    "bull": "^4.16.5",
    "bullmq": "^5.8.4",
    "cache-manager": "^7.2.8",
    "cache-manager-ioredis": "^2.1.0",
    "cache-manager-redis-yet": "^5.1.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "csv-parse": "^5.5.6",
    "dayjs": "^1.11.12",
    "dotenv": "^17.4.2",
    "fast-xml-parser": "^5.9.0",
    "ioredis": "^5.3.2",
    "keyv": "^5.6.0",
    "knex": "^3.2.10",
    "minio": "^8.0.1",
    "multer": "^1.4.5-lts.1",
    "nestjs-pino": "^4.6.1",
    "nodemailer": "^9.0.1",
    "openai": "^4.52.7",
    "opossum": "^8.1.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.21.0",
    "pino-http": "^11.0.0",
    "qs": "^6.15.2",
    "redis": "^6.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.2",
    "@nestjs/schematics": "^10.1.3",
    "@nestjs/testing": "^10.3.10",
    "@types/bcrypt": "^5.0.2",
    "@types/bull": "^4.10.4",
    "@types/cache-manager-ioredis": "^2.0.8",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.12",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.14.10",
    "@types/opossum": "^8.1.4",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdf-parse": "^1.1.4",
    "@types/qs": "^6.15.1",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^9.7.0",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.3",
    "ts-jest": "^29.2.2",
    "ts-node": "^10.9.2",
    "typeorm-ts-node-commonjs": "^0.3.20",
    "typescript": "^5.5.3"
  }
}
